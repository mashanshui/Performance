<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/crash_cases_title" android:textSize="24sp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:text="@string/crash_cases_description" />
        <Button android:id="@+id/explicitCrashButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/crash_cases_explicit" />
        <Button android:id="@+id/nullCrashButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/crash_cases_null" />
        <Button android:id="@+id/boundsCrashButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/crash_cases_bounds" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:text="@string/crash_cases_state_description" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:labelFor="@+id/runtimeStateInput" android:text="@string/crash_cases_state_label" />
        <EditText android:id="@id/runtimeStateInput" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:minHeight="48dp" android:hint="@string/crash_cases_state_hint" android:inputType="text"
            android:maxLength="256" android:singleLine="true" android:saveEnabled="false" />
        <Button android:id="@+id/stateCrashButton" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/crash_cases_state" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:text="@string/crash_cases_async_description" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:labelFor="@+id/externalResponseInput" android:text="@string/crash_cases_async_label" />
        <EditText android:id="@id/externalResponseInput" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:minHeight="48dp" android:hint="@string/crash_cases_async_hint" android:inputType="text"
            android:maxLength="256" android:singleLine="true" android:saveEnabled="false" />
        <Button android:id="@+id/asyncCrashButton" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/crash_cases_async" />
        <Button android:id="@+id/closeCrashPageButton" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/crash_cases_close" />
    </LinearLayout>
</ScrollView>
